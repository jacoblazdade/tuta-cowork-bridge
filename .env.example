# tuta-cowork-bridge settings. Copy to your private config location (macOS default:
# ~/Library/Application Support/tuta-cowork-bridge/bridge.env); scripts/setup.sh writes it for you.
# Never put secrets here: Tuta credentials and the MCP API key live in the Keychain
# (or, with TCB_CREDENTIAL_BACKEND=file, in a separate chmod-600 file outside the repo).

# Listener (loopback only unless TCB_ALLOW_NON_LOOPBACK=1 inside an isolated container network)
TCB_HOST=127.0.0.1
TCB_PORT=8080
TCB_MCP_PATH=/mcp

# Hostname(s) clients use to reach the bridge through your HTTPS proxy (Host-header allowlist)
TCB_PUBLIC_HOSTS=your-machine.your-tailnet.ts.net

# Browser origins allowed to call the endpoint (requests without an Origin header are unaffected)
TCB_ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# Credentials: "keychain" (macOS) or "file"
TCB_CREDENTIAL_BACKEND=keychain
TCB_KEYCHAIN_SERVICE=tuta-cowork-bridge
# TCB_CREDENTIALS_FILE=/path/outside/repo/credentials.env   # file backend: TUTA_EMAIL, TUTA_PASSWORD, TUTA_TOTP_SECRET, TCB_API_KEY

# Limits
TCB_RATE_PER_MINUTE=120
TCB_MAX_BODY_BYTES=262144
TCB_TOOL_TIMEOUT=90
TCB_MAX_CONCURRENT_TOOLS=4

TCB_LOG_LEVEL=INFO
# TCB_LOG_FILE=/path/to/bridge.log
